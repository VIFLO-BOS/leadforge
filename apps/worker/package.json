{
  "name": "@leadforge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,worker -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch -r dotenv/config dist/main.js dotenv_config_path=../../.env\"",
    "start": "node -r dotenv/config dist/main.js dotenv_config_path=../../.env",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@leadforge/contracts": "workspace:*",
    "@leadforge/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "bullmq": "^5.50.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@leadforge/config": "workspace:*",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
