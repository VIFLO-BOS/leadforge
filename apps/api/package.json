{
  "name": "@leadforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch -r dotenv/config dist/main.js",
    "start": "node -r dotenv/config dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@leadforge/contracts": "workspace:*",
    "@leadforge/core": "workspace:*",
    "@leadforge/db-mongo": "workspace:*",
    "@leadforge/db-postgres": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "uuid": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "nestjs-pino": "^4.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@leadforge/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "bullmq": "^5.50.0",
    "ioredis": "^5.6.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0"
  }
}
