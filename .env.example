# Copy to .env at the repository root. Never commit real secrets.
# All values below are development defaults matching infra/docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL (identity + billing)
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5432/leadforge?schema=public

# MongoDB (business intelligence). Replica set is required for transactions.
MONGODB_URI="mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"
MONGODB_DB=leadforge

# Redis (queues, rate limiting)
REDIS_URL=redis://localhost:6379
# BullMQ key prefix shared by the API (producer) and the worker. Give each stack on a shared
# Redis its own prefix (for example leadforge-ada) so workers never take another stack's jobs.
QUEUE_PREFIX=leadforge

# Auth. Generate real keys with: pnpm gen:keys
# Values are base64url-encoded JSON Web Keys (Ed25519).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=dev-csrf-secret-change-me-32-characters

# Mail (Mailpit in development: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="LeadForge <no-reply@leadforge.local>"

# Worker: comma-separated queue allowlist. Empty means all queues.
WORKER_QUEUES=

# Reverse proxies in front of the API that append to X-Forwarded-For (Express "trust proxy").
# Count every hop: a load balancer, plus the web app when browsers reach the API through its
# /api rewrite. Rate limits, audit IPs and the webhook IP allowlist depend on it (docs/DEPLOYMENT.md).
TRUST_PROXY_HOPS=1
# Requests per minute per user (or per address when signed out) across the API. Sensitive routes
# keep tighter limits of their own. Raise only for load tests.
RATE_LIMIT_PER_MINUTE=600

# Prometheus metrics (docs/OPERATIONS.md, "Monitoring"). API: GET /metrics (outside /api/v1).
# Worker: a small server on WORKER_METRICS_HOST:WORKER_METRICS_PORT (0 turns it off).
# With METRICS_TOKEN set (24+ characters) both require "Authorization: Bearer <token>"; without
# it the API answers loopback callers only (never in production) and the worker stays on loopback.
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1

# Overture Maps Places (the discovery source). The worker checks the STAC catalogue on this
# interval and loads a release once, when a new one appears; pnpm overture:sync runs it by hand.
OVERTURE_STAC_URL=https://stac.overturemaps.org/catalog.json
# Register the repeatable sync in the worker. Empty means on in production, off elsewhere.
OVERTURE_SYNC_SCHEDULE=
OVERTURE_SYNC_INTERVAL_MS=86400000
# Places per discovery page read from the staging catalogue.
OVERTURE_PAGE_SIZE=100
# Development and tests only (refused when NODE_ENV=production): load a local Parquet file
# (the raw Overture places schema or the flattened research extract) and local division
# boundaries instead of the published release. Set both paths or neither. The release label is
# needed when the file does not carry one, for example 2026-10-21.0.
OVERTURE_LOCAL_PLACES_PATH=
OVERTURE_LOCAL_DIVISIONS_PATH=
OVERTURE_LOCAL_RELEASE=

# Google Places API (New). Unavailable under Google's terms (decided 2026-10-25): the source is
# never runnable, with or without a key. Kept for the adapter's tests.
GOOGLE_PLACES_API_KEY=
# Development and tests only: replay hand-built Google Places fixtures instead of calling Google.
# The API and worker refuse to start with this on when NODE_ENV=production.
GOOGLE_PLACES_FIXTURE_MODE=false

# Discovery jobs (defaults shown): time limit per job, page retry backoff doubling from
# base to max, attempts per page, and job creations per hour per organization.
DISCOVERY_JOB_TIMEOUT_MS=7200000
DISCOVERY_RETRY_BASE_MS=30000
DISCOVERY_RETRY_MAX_MS=600000
DISCOVERY_PAGE_ATTEMPTS=4
DISCOVERY_JOBS_PER_HOUR=30

# Website fetching (SafeFetch: website analysis and contact enrichment, worker only).
# User agent sent with every request; robots.txt is matched on its first word (LeadForgeBot).
# Empty means "LeadForgeBot/1.0 (+<APP_URL>/legal/data-collection)".
SAFE_FETCH_USER_AGENT=
# Requests per second per host (0.5 = one every 2 seconds) and across all hosts.
SAFE_FETCH_HOST_RPS=0.5
SAFE_FETCH_GLOBAL_RPS=10
# Deadline per request (connect plus read) and the delay before retrying an unreachable home page.
SAFE_FETCH_TIMEOUT_MS=10000
SAFE_FETCH_RETRY_DELAY_MS=2000
# Development and tests only: host=ip:port pairs served from a local address, for example a local
# test site (smoke-site.test=127.0.0.1:4299). Bypasses DNS and the deny list for those exact names
# only. The API and worker refuse to start with this set when NODE_ENV=production.
SAFE_FETCH_HOST_OVERRIDES=

# Object storage for export files (Phase 5). "local" writes under OBJECT_STORAGE_LOCAL_DIR
# (empty: <os temp dir>/leadforge-object-storage); the API and worker must share that directory,
# so use it for development and single-host installs. "s3" works with AWS S3 and S3-compatible
# services (MinIO, Cloudflare R2) through Signature Version 4 presigned requests; it needs the
# bucket and credentials below. Endpoint empty means https://s3.<region>.amazonaws.com.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Path-style URLs (endpoint/bucket/key); MinIO and most S3-compatible services need true.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Export jobs (Phase 5). HMAC key for signed download links (32+ characters); empty derives one
# from CSRF_SECRET. Link lifetime, file retention, and the row cap used when the organization has
# no export_row_cap entitlement (plans set it; this is the free tier's cap).
EXPORT_SIGNING_SECRET=
EXPORT_DOWNLOAD_URL_TTL_SECONDS=900
EXPORT_FILE_TTL_HOURS=168
EXPORT_DEFAULT_ROW_CAP=10000

# Billing with Paystack (Phase 6). Empty key: billing shows "not configured" and checkout is
# refused with BILLING_NOT_CONFIGURED (nothing is faked). sk_test_... runs Paystack test mode;
# sk_live_... takes real money. The same key signs webhooks (HMAC-SHA512 of the raw body). Server
# only: never expose it to the browser (the redirect checkout needs no public key).
PAYSTACK_SECRET_KEY=
# Optional comma-separated webhook source IPs (Paystack publishes them); empty accepts any address.
# The signature is always required.
PAYSTACK_WEBHOOK_IP_ALLOWLIST=
# Paystack API origin. Development and tests may point it at a local fixture server; production
# must use the default.
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack returns the browser after checkout. Empty: <APP_URL>/app/billing/return.
BILLING_CALLBACK_URL=
# Reconciliation: verify pending payments older than this (minutes); mark unpaid checkouts abandoned
# after this many hours; a past_due subscription expires this many days after a failed renewal.
BILLING_PENDING_VERIFY_AFTER_MINUTES=20
BILLING_PENDING_ABANDON_AFTER_HOURS=24
BILLING_PAST_DUE_GRACE_DAYS=7
# Member cap without a subscription (free tier).
BILLING_FREE_MAX_MEMBERS=5
# Optional JSON file with plans and credit packs for pnpm billing:catalogue and pnpm db:seed (shape:
# DEFAULT_BILLING_CATALOGUE in packages/core/src/billing/catalogue.ts). Empty: the built-in
# catalogue, whose prices are all unpublished placeholders (0).
BILLING_CATALOGUE_PATH=

# Next.js
NEXT_PUBLIC_APP_NAME=LeadForge
NEXT_PUBLIC_API_BASE=/api
