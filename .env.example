# Copy to .env at the repository root. Never commit real secrets.
# All values below are development defaults matching infra/docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL (identity + billing)
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5432/leadforge?schema=public

# MongoDB (business intelligence). Replica set is required for transactions.
MONGODB_URI="mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"
MONGODB_DB=leadforge

# Redis (queues, rate limiting)
REDIS_URL=redis://localhost:6379

# Auth. Generate real keys with: pnpm gen:keys
# Values are base64url-encoded JSON Web Keys (Ed25519).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=dev-csrf-secret-change-me-32-characters

# Mail (Mailpit in development: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="LeadForge <no-reply@leadforge.local>"

# Worker: comma-separated queue allowlist. Empty means all queues.
WORKER_QUEUES=

# Next.js
NEXT_PUBLIC_APP_NAME=LeadForge
NEXT_PUBLIC_API_BASE=/api
