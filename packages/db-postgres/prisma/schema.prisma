// LeadForge PostgreSQL schema: identity and money.
// MongoDB owns business intelligence; see docs/DATABASE_DESIGN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash")
  name            String
  avatarUrl       String?   @map("avatar_url")
  locale          String    @default("en")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  authProviders   Json?     @map("auth_providers")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions                Session[]
  emailTokens             EmailToken[]
  memberships             Membership[]
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  sentInvitations         Invitation[]
  notificationPreferences NotificationPreference[]
  apiKeysCreated          ApiKey[]

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

enum EmailTokenPurpose {
  verify_email
  reset_password
}

model EmailToken {
  id         String            @id @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  purpose    EmailTokenPurpose
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at")
  consumedAt DateTime?         @map("consumed_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Organization {
  id                        String    @id @db.Uuid
  name                      String
  slug                      String    @unique
  country                   String    @db.Char(2)
  defaultCurrency           String    @default("NGN") @map("default_currency") @db.Char(3)
  freshnessDays             Int       @default(180) @map("freshness_days")
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  /// Stage 10: set when the purge starts; from then on no member can open the organization.
  deletedAt                 DateTime? @map("deleted_at")
  deletionRequestedAt       DateTime? @map("deletion_requested_at")
  /// Stage 10: the owner who asked for the deletion, and when the purge may start (requested + 14 days).
  deletionRequestedByUserId String?   @map("deletion_requested_by_user_id") @db.Uuid
  purgeAfter                DateTime? @map("purge_after")
  /// Stage 10: the "deletion in 3 days" reminder went out (cleared when a deletion is cancelled).
  deletionReminderSentAt    DateTime? @map("deletion_reminder_sent_at")
  /// Stage 10: the purge finished; the row stays (invoices and the ledger point at it), anonymized.
  purgedAt                  DateTime? @map("purged_at")

  createdBy               User                     @relation("OrganizationCreator", fields: [createdByUserId], references: [id])
  memberships             Membership[]
  invitations             Invitation[]
  apiKeys                 ApiKey[]
  notificationPreferences NotificationPreference[]
  billingCustomer         BillingCustomer?
  usageDaily              UsageDaily[]

  @@index([purgeAfter])
  @@map("organizations")
}

/// Stage 10: one erasure record per purged organization. It deliberately has no foreign key and
/// holds no personal data (ids, timestamps, counts), so it outlives the purge and tells operators
/// which deletions to re-apply after a restore (docs/OPERATIONS.md). `steps` records each finished
/// step (`{ "<step>": { "completedAt": iso, ...counts } }`) so a crashed purge resumes where it stopped.
model OrganizationErasure {
  id                String    @id @db.Uuid
  organizationId    String    @unique @map("organization_id") @db.Uuid
  requestedAt       DateTime? @map("requested_at")
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  purgeAfter        DateTime? @map("purge_after")
  /// schedule (the maintenance scan) or reapply (re-run after a restore).
  trigger           String    @default("schedule")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  attempts          Int       @default(0)
  steps             Json      @default("{}")
  lastError         String?   @map("last_error")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("organization_erasures")
}

enum OrganizationRole {
  owner
  admin
  researcher
  sales_rep
  analyst
}

enum MembershipStatus {
  active
  suspended
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id              String           @id @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  role            OrganizationRole
  tokenHash       String           @unique @map("token_hash")
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedByUserId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

// Created now, feature disabled in release 1.
model ApiKey {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  keyPrefix       String    @map("key_prefix")
  keyHash         String    @unique @map("key_hash")
  scopes          String[]
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@map("api_keys")
}

model NotificationPreference {
  userId           String   @map("user_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  emailJobEvents   Boolean  @default(true) @map("email_job_events")
  emailBilling     Boolean  @default(true) @map("email_billing")
  inappAll         Boolean  @default(true) @map("inapp_all")
  emailAssignments Boolean  @default(true) @map("email_assignments")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Billing (authoritative). Amounts are minor units (kobo) as BigInt.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  paystack
}

model BillingCustomer {
  id                   String          @id @db.Uuid
  organizationId       String          @unique @map("organization_id") @db.Uuid
  provider             PaymentProvider @default(paystack)
  providerCustomerCode String?         @unique @map("provider_customer_code")
  email                String
  creditBalance        Int             @default(0) @map("credit_balance")
  currency             String          @default("NGN") @db.Char(3)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  ledger        CreditLedger[]
  entitlements  Entitlement[]
  audit         BillingAudit[]
  disputes      PaymentDispute[]

  @@map("billing_customers")
}

enum PlanInterval {
  monthly
  yearly
}

model Plan {
  id                     String       @id @db.Uuid
  code                   String       @unique
  name                   String
  description            String?
  interval               PlanInterval
  priceMinor             BigInt       @map("price_minor")
  currency               String       @db.Char(3)
  includedCredits        Int          @map("included_credits")
  maxMembers             Int          @map("max_members")
  exportRowCap           Int          @map("export_row_cap")
  /// Phase 6 entitlements carried by the plan (written to `entitlements` on plan changes).
  discoveryEnabled       Boolean      @default(true) @map("discovery_enabled")
  websiteAnalysisEnabled Boolean      @default(true) @map("website_analysis_enabled")
  isActive               Boolean      @default(true) @map("is_active")
  isPlaceholder          Boolean      @default(true) @map("is_placeholder")
  providerPlanCode       String?      @unique @map("provider_plan_code")
  sortOrder              Int          @default(0) @map("sort_order")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model CreditPack {
  id            String   @id @db.Uuid
  code          String   @unique
  name          String
  credits       Int
  priceMinor    BigInt   @map("price_minor")
  currency      String   @db.Char(3)
  isActive      Boolean  @default(true) @map("is_active")
  isPlaceholder Boolean  @default(true) @map("is_placeholder")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("credit_packs")
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  cancelled
  expired
}

model Subscription {
  id                       String             @id @db.Uuid
  billingCustomerId        String             @map("billing_customer_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(incomplete)
  providerSubscriptionCode String?            @unique @map("provider_subscription_code")
  providerEmailToken       String?            @map("provider_email_token")
  currentPeriodStart       DateTime?          @map("current_period_start")
  currentPeriodEnd         DateTime?          @map("current_period_end")
  cancelAtPeriodEnd        Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt              DateTime?          @map("cancelled_at")
  /// Phase 6: when the subscription became past_due (failed renewal); cleared when a renewal succeeds.
  pastDueAt                DateTime?          @map("past_due_at")
  /// Phase 6: when it became cancelled or expired.
  endedAt                  DateTime?          @map("ended_at")
  /// Phase 6: the provider's own status word at the last sync (active, non-renewing, attention, complete, cancelled).
  providerStatus           String?            @map("provider_status")
  lastSyncedAt             DateTime?          @map("last_synced_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])
  plan            Plan            @relation(fields: [planId], references: [id])
  invoices        Invoice[]

  @@index([billingCustomerId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

model Invoice {
  id                  String        @id @db.Uuid
  billingCustomerId   String        @map("billing_customer_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  number              String        @unique
  status              InvoiceStatus @default(draft)
  subtotalMinor       BigInt        @map("subtotal_minor")
  taxMinor            BigInt        @default(0) @map("tax_minor")
  totalMinor          BigInt        @map("total_minor")
  currency            String        @db.Char(3)
  issuedAt            DateTime?     @map("issued_at")
  dueAt               DateTime?     @map("due_at")
  paidAt              DateTime?     @map("paid_at")
  providerInvoiceCode String?       @unique @map("provider_invoice_code")
  pdfKey              String?       @map("pdf_key")
  /// Phase 6: line items `[{ description, quantity, unitMinor, amountMinor }]` (minor units as strings).
  lines               Json          @default("[]")
  /// Phase 6: who the invoice is addressed to `{ organizationName, email, country }`, frozen at issue.
  billTo              Json?         @map("bill_to")
  periodStart         DateTime?     @map("period_start")
  periodEnd           DateTime?     @map("period_end")
  pdfGeneratedAt      DateTime?     @map("pdf_generated_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  payments        Payment[]

  @@index([billingCustomerId, status])
  @@map("invoices")
}

enum PaymentPurpose {
  subscription
  credit_pack
}

enum PaymentStatus {
  pending
  success
  failed
  reversed
  abandoned
}

model Payment {
  id                    String          @id @db.Uuid
  billingCustomerId     String          @map("billing_customer_id") @db.Uuid
  invoiceId             String?         @map("invoice_id") @db.Uuid
  purpose               PaymentPurpose
  purposeRef            String          @map("purpose_ref") @db.Uuid
  provider              PaymentProvider @default(paystack)
  providerReference     String          @unique @map("provider_reference")
  providerTransactionId String?         @unique @map("provider_transaction_id")
  amountMinor           BigInt          @map("amount_minor")
  currency              String          @db.Char(3)
  status                PaymentStatus   @default(pending)
  channel               String?
  authorizationMasked   Json?           @map("authorization_masked")
  initiatedAt           DateTime        @default(now()) @map("initiated_at")
  verifiedAt            DateTime?       @map("verified_at")
  failedAt              DateTime?       @map("failed_at")
  reversedAt            DateTime?       @map("reversed_at")
  lastEventId           String?         @map("last_event_id") @db.Uuid
  idempotencyKey        String          @unique @map("idempotency_key")
  /// Phase 6: credits this payment buys (credit packs), frozen at checkout.
  creditUnits           Int?            @map("credit_units")
  /// Phase 6: what was bought, e.g. "Credit pack: 500 credits" (frozen at checkout).
  description           String?
  /// Phase 6: hosted checkout returned by the provider, replayed for a repeated Idempotency-Key.
  authorizationUrl      String?         @map("authorization_url")
  accessCode            String?         @map("access_code")
  /// Phase 6: the provider's last status word and gateway message from verify.
  providerStatus        String?         @map("provider_status")
  gatewayResponse       String?         @map("gateway_response")
  paidAt                DateTime?       @map("paid_at")
  lastVerifiedAt        DateTime?       @map("last_verified_at")
  verifyAttempts        Int             @default(0) @map("verify_attempts")
  /// Phase 6: set when verification disagrees (amount, currency, reference) or a dispute opens; no grant while set.
  flagReason            String?         @map("flag_reason")
  flaggedAt             DateTime?       @map("flagged_at")
  /// Phase 6: total of processed refunds in minor units.
  refundedMinor         BigInt          @default(0) @map("refunded_minor")
  initiatedByUserId     String?         @map("initiated_by_user_id") @db.Uuid

  billingCustomer BillingCustomer  @relation(fields: [billingCustomerId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  refunds         Refund[]
  disputes        PaymentDispute[]

  @@index([billingCustomerId, status, initiatedAt])
  @@index([status, initiatedAt])
  @@map("payments")
}

enum RefundStatus {
  pending
  processed
  failed
}

model Refund {
  id                      String       @id @db.Uuid
  paymentId               String       @map("payment_id") @db.Uuid
  providerRefundReference String?      @unique @map("provider_refund_reference")
  amountMinor             BigInt       @map("amount_minor")
  currency                String       @db.Char(3)
  status                  RefundStatus @default(pending)
  reason                  String?
  createdAt               DateTime     @default(now()) @map("created_at")
  processedAt             DateTime?    @map("processed_at")
  /// Phase 6: who asked for it (null when it started in the provider dashboard).
  requestedByUserId       String?      @map("requested_by_user_id") @db.Uuid
  providerStatus          String?      @map("provider_status")
  failureReason           String?      @map("failure_reason")
  failedAt                DateTime?    @map("failed_at")
  /// Phase 6: credits clawed back by the refund_reversal ledger entry.
  reversalUnits           Int?         @map("reversal_units")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

enum WebhookProcessingStatus {
  received
  processed
  ignored
  failed
}

model PaymentWebhookEvent {
  id               String                  @id @db.Uuid
  provider         PaymentProvider
  providerEventId  String                  @map("provider_event_id")
  eventType        String                  @map("event_type")
  reference        String?
  signatureValid   Boolean                 @map("signature_valid")
  payload          Json
  receivedAt       DateTime                @default(now()) @map("received_at")
  processedAt      DateTime?               @map("processed_at")
  processingStatus WebhookProcessingStatus @default(received) @map("processing_status")
  error            String?
  /// Phase 6: processing attempts (the worker and reconciliation).
  attempts         Int                     @default(0)

  @@unique([provider, providerEventId])
  @@index([reference])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

enum LedgerEntryType {
  grant
  purchase
  hold
  capture
  release
  adjustment
  refund_reversal
  expiry
}

model CreditLedger {
  id                String          @id @db.Uuid
  billingCustomerId String          @map("billing_customer_id") @db.Uuid
  entryType         LedgerEntryType @map("entry_type")
  units             Int
  capturedUnits     Int?            @map("captured_units")
  balanceAfter      Int             @map("balance_after")
  referenceType     String?         @map("reference_type")
  referenceId       String?         @map("reference_id")
  referenceName     String?         @map("reference_name")
  holdId            String?         @map("hold_id") @db.Uuid
  idempotencyKey    String          @unique @map("idempotency_key")
  description       String?
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])
  hold            CreditLedger?   @relation("HoldChildren", fields: [holdId], references: [id])
  children        CreditLedger[]  @relation("HoldChildren")

  @@index([billingCustomerId, createdAt])
  @@index([referenceType, referenceId])
  @@index([holdId])
  @@index([entryType, createdAt])
  @@map("credit_ledger")
}

enum EntitlementSource {
  plan
  override
}

model Entitlement {
  id                String            @id @db.Uuid
  billingCustomerId String            @map("billing_customer_id") @db.Uuid
  key               String
  valueInt          Int?              @map("value_int")
  valueBool         Boolean?          @map("value_bool")
  source            EntitlementSource
  validFrom         DateTime          @default(now()) @map("valid_from")
  validTo           DateTime?         @map("valid_to")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@unique([billingCustomerId, key, source])
  @@map("entitlements")
}

enum ReconciliationKind {
  payments
  holds
  subscriptions
  webhooks
}

model ReconciliationRun {
  id         String             @id @db.Uuid
  kind       ReconciliationKind
  startedAt  DateTime           @default(now()) @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  checked    Int                @default(0)
  fixed      Int                @default(0)
  errors     Json?

  @@map("reconciliation_runs")
}

model BillingAudit {
  id                String   @id @db.Uuid
  billingCustomerId String   @map("billing_customer_id") @db.Uuid
  actorType         String   @map("actor_type")
  actorId           String?  @map("actor_id")
  action            String
  before            Json?
  after             Json?
  requestId         String?  @map("request_id")
  createdAt         DateTime @default(now()) @map("created_at")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])

  @@index([billingCustomerId, createdAt])
  @@map("billing_audit")
}

/// Phase 6: gap-free invoice numbering. One row per scope (the calendar year); the counter is
/// incremented under a row lock inside the transaction that issues the invoice, so a rolled-back
/// payment never consumes a number.
model InvoiceCounter {
  scope     String @id
  lastValue Int    @default(0) @map("last_value")

  @@map("invoice_counters")
}

enum DisputeStatus {
  open
  awaiting_merchant
  awaiting_bank
  resolved
}

/// Phase 6: chargebacks reported by the provider (charge.dispute.*). Recorded and alerted; the
/// payment is flagged while one is open.
model PaymentDispute {
  id                String        @id @db.Uuid
  billingCustomerId String        @map("billing_customer_id") @db.Uuid
  paymentId         String        @map("payment_id") @db.Uuid
  providerDisputeId String        @unique @map("provider_dispute_id")
  status            DisputeStatus @default(open)
  providerStatus    String?       @map("provider_status")
  resolution        String?
  amountMinor       BigInt?       @map("amount_minor")
  currency          String?       @db.Char(3)
  reason            String?
  dueAt             DateTime?     @map("due_at")
  openedAt          DateTime      @default(now()) @map("opened_at")
  resolvedAt        DateTime?     @map("resolved_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id])
  payment         Payment         @relation(fields: [paymentId], references: [id])

  @@index([billingCustomerId, openedAt])
  @@map("payment_disputes")
}

model UsageDaily {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  day            DateTime @db.Date
  metric         String
  value          BigInt
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, metric])
  @@index([organizationId, metric, day])
  @@map("usage_daily")
}

enum ContactSubmissionKind {
  contact
  data_request
}

model ContactSubmission {
  id        String                @id @db.Uuid
  kind      ContactSubmissionKind @default(contact)
  name      String
  email     String
  company   String?
  message   String
  ipHash    String?               @map("ip_hash")
  createdAt DateTime              @default(now()) @map("created_at")
  handledAt DateTime?             @map("handled_at")

  @@index([kind, handledAt])
  @@map("contact_submissions")
}
